# Сервер
NODE_ENV=development
PORT=4005

# База данных
DB_HOST=localhost
DB_PORT=5432
DB_NAME=p_lms
DB_USER=postgres
DB_PASSWORD=

# Сессии (таблица session должна существовать в БД)
SESSION_SECRET=change-this-secret-in-production
SESSION_MAX_AGE=86400000

# Языки
DEFAULT_LANGUAGE=ru
SUPPORTED_LANGUAGES=ru,kk,en

# Origin фронта. Несколько — через запятую.
CORS_ORIGIN=http://localhost:5173

# LibreOffice для конвертации RTF в модуле загрузки тестов
SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
